//@version=5
// ============================================================================
// ZARUS30 Clone - Zonas OB & Vista Limpia (v2)
// ----------------------------------------------------------------------------
// Es el MISMO script del usuario, con 5 arreglos INVISIBLES para poder operar
// de verdad con el (mismo aspecto, mismas senales, mismas zonas):
//   1. SIN REPINTADO: el estado (trend_dir/trail_stop) y las zonas SOLO se
//      actualizan al CIERRE de vela (barstate.isconfirmed). Con crossover
//      intrabar la senal podia aparecer y desaparecer antes del cierre.
//   2. ARRANQUE ROBUSTO: se exige direccion previa +/-1 antes de disparar
//      (prev_dir), inmune a reinicializaciones del estado.
//   3. ZONAS ROBUSTAS: guardas contra na (la version original podia crashear
//      creando una caja con precio na en las primeras velas), saneo de zonas
//      imposibles y left nunca negativo.
//   4. SL POR ACTIVO: se mantienen US30=80 y Oro=12 y se anaden NAS100=20,
//      GBPJPY=20 y BTCUSD=500 (antes el resto caia en SL de US30 por error).
//   5. ALERTAS: alertcondition() + alert() JSON (action/symbol/price/sl/tp1/
//      tp2/tp3) para conectar el bot por webhook. Sin efecto visual.
//
// Cómo activar la alerta para el bot:
//   Crear alerta -> Condicion = "Cualquier llamada a la funcion alert()"
//   (Any alert() function call) -> Webhook URL del bot. Operar en la APERTURA
//   de la vela siguiente al aviso (la senal se imprime al cierre).
// ============================================================================

indicator("ZARUS30 Clone - Zonas OB & Vista Limpia (v2)", overlay=true, max_labels_count=100, max_boxes_count=100, max_lines_count=100)

// --- PARÁMETROS BASE ---
atr_len      = input.int(10, "Período ATR", group="Canal de Tendencia")
atr_mult     = input.float(3.0, "Multiplicador ATR", group="Canal de Tendencia")
us30_sl_pts  = input.float(80.0, "Stop Loss US30 (Puntos)", group="Gestión de Riesgo")
nas_sl_pts   = input.float(20.0, "Stop Loss NAS100 (Pips)", group="Gestión de Riesgo")
gold_sl_pts  = input.float(12.0, "Stop Loss Oro (Puntos)", group="Gestión de Riesgo")
gjp_sl_pts   = input.float(20.0, "Stop Loss GBPJPY (Pips)", group="Gestión de Riesgo")
btc_sl_pts   = input.float(500.0, "Stop Loss BTCUSD (USD)", group="Gestión de Riesgo")
proj_bars    = input.int(20, "Proyección Líneas (Velas)", group="Visualización")
left_bars    = input.int(5, "Pivotes Izquierda OB", group="Zonas de Interés (SMC)")
right_bars   = input.int(3, "Pivotes Derecha OB", group="Zonas de Interés (SMC)")

// --- SL POR ACTIVO (arreglo 4: antes solo US30 y Oro) ---
sl_points = us30_sl_pts
if str.contains(syminfo.ticker, "BTC")
    sl_points := btc_sl_pts
else if str.contains(syminfo.ticker, "NAS") or str.contains(syminfo.ticker, "USTEC")
    sl_points := nas_sl_pts
else if str.contains(syminfo.ticker, "GBPJPY") or (str.contains(syminfo.ticker, "GBP") and str.contains(syminfo.ticker, "JPY"))
    sl_points := gjp_sl_pts
else if str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
    sl_points := gold_sl_pts

// --- CÁLCULO ATR STEPPED (arreglo 1: estado SOLO al cierre de vela) ---
atr_val    = ta.atr(atr_len)
upper_band = high - (atr_mult * atr_val)
lower_band = low + (atr_mult * atr_val)

var float trail_stop = na
var int   trend_dir  = 0 // 1: Alcista, -1: Bajista
var int   prev_dir   = 0

bool buy_trigger  = false
bool sell_trigger = false

if barstate.isconfirmed
    prev_dir := trend_dir
    if na(trail_stop)
        trail_stop := close
        trend_dir  := 1
    if trend_dir == 1
        if close < trail_stop
            trend_dir  := -1
            trail_stop := lower_band
        else
            trail_stop := math.max(trail_stop, upper_band)
    else
        if close > trail_stop
            trend_dir  := 1
            trail_stop := upper_band
        else
            trail_stop := math.min(trail_stop, lower_band)
    // Flip confirmado (arreglo 2: prev_dir +/-1 excluye disparos de arranque)
    buy_trigger  := trend_dir == 1 and prev_dir == -1
    sell_trigger := trend_dir == -1 and prev_dir == 1

// Nube dinámica
p_price = plot(hl2, display=display.none)
p_band  = plot(trail_stop, "Banda Dinámica", color=trend_dir == 1 ? color.green : color.red, style=plot.style_stepline, linewidth=2)
fill(p_price, p_band, color=trend_dir == 1 ? color.new(color.green, 88) : color.new(color.red, 88))

// --- GESTIÓN DE LÍNEAS DE TRADE ACTIVO (SIN ACUMULACIÓN) ---
var line l_entry = na
var line l_sl    = na
var line l_tp1   = na
var line l_tp2   = na
var line l_tp3   = na

var label lb_sl  = na
var label lb_tp1 = na
var label lb_tp2 = na
var label lb_tp3 = na

f_limpiar_lineas() =>
    line.delete(l_entry)
    line.delete(l_sl)
    line.delete(l_tp1)
    line.delete(l_tp2)
    line.delete(l_tp3)
    label.delete(lb_sl)
    label.delete(lb_tp1)
    label.delete(lb_tp2)
    label.delete(lb_tp3)

if buy_trigger
    f_limpiar_lineas()
    entry = close
    sl    = entry - sl_points
    tp1   = entry + (sl_points * 1.0)
    tp2   = entry + (sl_points * 2.0)
    tp3   = entry + (sl_points * 3.0)

    label.new(bar_index, low - (atr_val * 0.4), "BUY", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)

    l_entry := line.new(bar_index, entry, bar_index + proj_bars, entry, color=color.gray, width=1, style=line.style_dotted)
    l_sl    := line.new(bar_index, sl, bar_index + proj_bars, sl, color=color.red, width=2)
    l_tp1   := line.new(bar_index, tp1, bar_index + proj_bars, tp1, color=color.teal, width=1)
    l_tp2   := line.new(bar_index, tp2, bar_index + proj_bars, tp2, color=color.teal, width=2)
    l_tp3   := line.new(bar_index, tp3, bar_index + proj_bars, tp3, color=color.teal, width=1)

    lb_sl   := label.new(bar_index + proj_bars, sl, "SL: " + str.tostring(sl, "#"), color=color.red, textcolor=color.white, style=label.style_label_left, size=size.tiny)
    lb_tp1  := label.new(bar_index + proj_bars, tp1, "TP1", color=color.teal, textcolor=color.white, style=label.style_label_left, size=size.tiny)
    lb_tp2  := label.new(bar_index + proj_bars, tp2, "TP2", color=color.teal, textcolor=color.white, style=label.style_label_left, size=size.tiny)
    lb_tp3  := label.new(bar_index + proj_bars, tp3, "TP3", color=color.teal, textcolor=color.white, style=label.style_label_left, size=size.tiny)

    // Alerta JSON para el bot (arreglo 5, sin efecto visual)
    alert('{"action":"BUY","symbol":"' + syminfo.ticker + '","price":' + str.tostring(entry, format.mintick) + ',"sl":' + str.tostring(sl, format.mintick) + ',"tp1":' + str.tostring(tp1, format.mintick) + ',"tp2":' + str.tostring(tp2, format.mintick) + ',"tp3":' + str.tostring(tp3, format.mintick) + '}', alert.freq_once_per_bar_close)

if sell_trigger
    f_limpiar_lineas()
    entry = close
    sl    = entry + sl_points
    tp1   = entry - (sl_points * 1.0)
    tp2   = entry - (sl_points * 2.0)
    tp3   = entry - (sl_points * 3.0)

    label.new(bar_index, high + (atr_val * 0.4), "SELL", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)

    l_entry := line.new(bar_index, entry, bar_index + proj_bars, entry, color=color.gray, width=1, style=line.style_dotted)
    l_sl    := line.new(bar_index, sl, bar_index + proj_bars, sl, color=color.red, width=2)
    l_tp1   := line.new(bar_index, tp1, bar_index + proj_bars, tp1, color=color.teal, width=1)
    l_tp2   := line.new(bar_index, tp2, bar_index + proj_bars, tp2, color=color.teal, width=2)
    l_tp3   := line.new(bar_index, tp3, bar_index + proj_bars, tp3, color=color.teal, width=1)

    lb_sl   := label.new(bar_index + proj_bars, sl, "SL: " + str.tostring(sl, "#"), color=color.red, textcolor=color.white, style=label.style_label_left, size=size.tiny)
    lb_tp1  := label.new(bar_index + proj_bars, tp1, "TP1", color=color.teal, textcolor=color.white, style=label.style_label_left, size=size.tiny)
    lb_tp2  := label.new(bar_index + proj_bars, tp2, "TP2", color=color.teal, textcolor=color.white, style=label.style_label_left, size=size.tiny)
    lb_tp3  := label.new(bar_index + proj_bars, tp3, "TP3", color=color.teal, textcolor=color.white, style=label.style_label_left, size=size.tiny)

    // Alerta JSON para el bot (arreglo 5, sin efecto visual)
    alert('{"action":"SELL","symbol":"' + syminfo.ticker + '","price":' + str.tostring(entry, format.mintick) + ',"sl":' + str.tostring(sl, format.mintick) + ',"tp1":' + str.tostring(tp1, format.mintick) + ',"tp2":' + str.tostring(tp2, format.mintick) + ',"tp3":' + str.tostring(tp3, format.mintick) + '}', alert.freq_once_per_bar_close)

// --- ZONAS DE INTERÉS (ORDER BLOCKS) CON MITIGACIÓN ---
p_high = ta.pivothigh(high, left_bars, right_bars)
p_low  = ta.pivotlow(low, left_bars, right_bars)

var float last_ph = na
var float last_pl = na

type OB
    box   b
    float top
    float btm
    bool  bull

var OB[] obs = array.new<OB>()

// Creación de Zona al haber quiebre de estructura (arreglo 1 y 3: SOLO vela
// confirmada, pivotes/ATR existentes, zona en el lado correcto del precio y
// left nunca negativo en las primeras velas).
if barstate.isconfirmed
    if not na(p_high)
        last_ph := p_high
    if not na(p_low)
        last_pl := p_low

    bool bos_up = not na(last_ph) and not na(last_pl) and not na(atr_val) and close > last_ph and close[1] <= last_ph and last_pl < close
    bool bos_dn = not na(last_ph) and not na(last_pl) and not na(atr_val) and close < last_pl and close[1] >= last_pl and last_ph > close

    if bos_up
        box_buy = box.new(math.max(0, bar_index - right_bars - 5), last_pl, bar_index + 15, last_pl - (atr_val * 0.7), bgcolor=color.new(color.blue, 85), border_color=color.blue, text="ZONA DE COMPRA (OB)", text_size=size.tiny, text_color=color.blue)
        array.push(obs, OB.new(box_buy, last_pl, last_pl - (atr_val * 0.7), true))
        last_ph := na

    if bos_dn
        box_sell = box.new(math.max(0, bar_index - right_bars - 5), last_ph + (atr_val * 0.7), bar_index + 15, last_ph, bgcolor=color.new(color.red, 85), border_color=color.red, text="ZONA DE VENTA (OB)", text_size=size.tiny, text_color=color.red)
        array.push(obs, OB.new(box_sell, last_ph + (atr_val * 0.7), last_ph, false))
        last_pl := na

    // Mitigación y extensión de Zonas activas
    if array.size(obs) > 0
        for i = array.size(obs) - 1 to 0
            o = array.get(obs, i)
            // Si el precio mitiga la zona, se corta la proyección
            mitigated = (o.bull and low < o.btm) or (not o.bull and high > o.top)
            if mitigated
                box.set_right(o.b, bar_index)
                array.remove(obs, i)
            else
                box.set_right(o.b, bar_index + 10)

// --- ALERTAS SIMPLES (alternativa sin JSON: condición por señal) ---
alertcondition(buy_trigger, "ZARUS30 BUY", "ZARUS30 BUY {{ticker}} @ {{close}} (senal al cierre de vela)")
alertcondition(sell_trigger, "ZARUS30 SELL", "ZARUS30 SELL {{ticker}} @ {{close}} (senal al cierre de vela)")
