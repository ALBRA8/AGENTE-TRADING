# ============================================================
# Agente Conversacional – Environment Variables Template
# ============================================================

# NVIDIA NIM API Key (get from https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Tavily API Key (búsqueda de noticias en tiempo real)
TAVILY_API_KEY=your_tavily_api_key_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MetaTrader 5 Bridge local (bridge.py)
MT5_BRIDGE_URL=http://localhost:5001

# MetaApi Credentials (opcional si usas bridge.py local)
# META_API_TOKEN=your_token_here
# META_ACCOUNT_ID=your_account_id_here

# Comma-separated list of allowed Telegram user IDs (whitelist)
ALLOWED_IDS=your_telegram_user_id_here

# SQLite database file path
DB_PATH=./data/agente.db

# Agent settings
AGENT_NAME=Agente Conversacional
MAX_TOOL_ITERATIONS=10

# Log level: debug | info | warn | error
LOG_LEVEL=info
