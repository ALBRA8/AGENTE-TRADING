# ============================================================
# Agente Conversacional – Environment Variables Template
# ============================================================

# NVIDIA NIM API Key (get from https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Tavily API Key (búsqueda de noticias en tiempo real)
# ⚠️ ROTADA pendiente: la key antigua quedó expuesta en el historial git
# (auditoría 9-h) — revócala en tavily.com antes de operar.
TAVILY_API_KEY=your_tavily_api_key_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MetaTrader 5 Bridge local (bridge.py)
MT5_BRIDGE_URL=http://localhost:5001
# Token de escritura del bridge (PROMPT 06 §5): /order y /cancel lo exigen.
# SIN configurar → el bridge RECHAZA órdenes (fail-closed). "" = desactivar
# el candado de forma explícita (solo entornos de prueba aislados).
BRIDGE_TOKEN=your_bridge_token_here

# Comma-separated list of allowed Telegram user IDs (whitelist)
ALLOWED_IDS=your_telegram_user_id_here

# SQLite database file path
DB_PATH=./data/agente.db

# ── PROMPT 06 §6/§19: GOBERNANZA / POLICY (defaults seguros) ──
# Modos: PAPER | SIMULATION | BACKTEST | RECOMMENDATION | MANUAL_APPROVAL | LIVE
POLICY_MODE=PAPER
# Nivel de autonomía efectivo (L0 OBSERVE … L5 SELF-IMPROVE) y su TECHO.
# LIVE exige techo ≥ 4 y nivel efectivo ≥ 4 (dos llaves explícitas).
AUTONOMY_LEVEL=2
AUTONOMY_CEILING=2
# Kill switch GLOBAL: on → ninguna orden real desde ninguna interfaz (§9)
KILL_SWITCH=off
# Segundo factor del modo LIVE (§11): sin él NADA sale a MT5
LIVE_TRADING=false

# ── PROMPT 06 §5: límites de seguridad del Execution Guard ──
# Whitelist de símbolos operables (fail-closed fuera de ella)
ALLOWED_SYMBOLS=US30,NAS100,XAUUSD,BTCUSD,GBPJPY
# Spread máximo como % del precio (0.0005 = 0.05%) y edad máxima del tick (s)
MAX_SPREAD_PCT=0.0005
MAX_TICK_AGE_S=120

# ── Dashboard / server ──
# Token bearer para POST /api/* y control de policy (OBLIGATORIO para LIVE)
DASHBOARD_TOKEN=
# 127.0.0.1 por defecto; exporta HOST solo con DASHBOARD_TOKEN configurado
HOST=127.0.0.1
RATE_LIMIT_PER_MIN=60

# ── Auto-mejora (PROMPT 06 §3/§4) ──
# Promoción automática de lecciones: OFF por defecto (§4 exige validación
# estadística + aprobación). Con "true" exige además wilson_lb≥0.6 y n≥30.
AUTO_PROMOTE_LESSONS=false
MIN_PATTERN_SEEN=5
MIN_SAMPLE=10

# ── Agent settings ──
AGENT_NAME=Agente Conversacional
MAX_TOOL_ITERATIONS=10

# Log level: debug | info | warn | error
LOG_LEVEL=info
